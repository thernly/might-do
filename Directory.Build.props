<Project>

  <!--
    The settings every project in this repository shares. They were copy-pasted
    across seven project files, which is how MightDo.App came to be the one
    project without TreatWarningsAsErrors — the project holding every UI-thread
    assumption and every event handler with nowhere to throw.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The port is written against a documented on-disk format; a warning
         about a possible null or an unused result is worth stopping for. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
