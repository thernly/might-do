<Project>

  <!--
    One place per package version. Avalonia was pinned in three project files
    and xunit in three more, so a version bump was a search-and-replace that
    could half-succeed.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
