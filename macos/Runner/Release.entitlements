<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Sandbox is deliberately off. See DebugProfile.entitlements for why:
  the workspace folder is user-chosen and must be reopenable on later launches,
  which the sandbox only allows via security-scoped bookmarks.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
