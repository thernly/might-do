<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MightDo.App.App"
             xmlns:local="using:MightDo.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
      <ResourceDictionary>
        <!-- The palette. Everything the views paint comes from these tokens,
             so the two variants live side by side and nothing borrows a
             stock Fluent grey ad hoc. -->
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <!-- Accent, with the shades Fluent's control states expect.
                 They are not recomputed when the base is overridden, so
                 leaving them out keeps stock blue in hover states. -->
            <Color x:Key="SystemAccentColor">#0F766E</Color>
            <Color x:Key="SystemAccentColorLight1">#13857C</Color>
            <Color x:Key="SystemAccentColorLight2">#2FA396</Color>
            <Color x:Key="SystemAccentColorLight3">#5FC2B5</Color>
            <Color x:Key="SystemAccentColorDark1">#0C5F59</Color>
            <Color x:Key="SystemAccentColorDark2">#094A45</Color>
            <Color x:Key="SystemAccentColorDark3">#063632</Color>

            <!-- Surface levels: window, panel, card. -->
            <SolidColorBrush x:Key="AppWindowBrush">#FAF9F6</SolidColorBrush>
            <SolidColorBrush x:Key="AppSurfaceBrush">#F0EEE8</SolidColorBrush>
            <SolidColorBrush x:Key="AppCardBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="AppChipBrush">#E9E6DF</SolidColorBrush>
            <SolidColorBrush x:Key="AppBorderBrush">#E2DFD8</SolidColorBrush>

            <SolidColorBrush x:Key="OverdueBrush">#C0361C</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityHighBackgroundBrush">#FCE8D5</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityHighForegroundBrush">#8F4A00</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityCriticalBackgroundBrush">#FADAD5</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityCriticalForegroundBrush">#9E2B18</SolidColorBrush>

            <!-- Text painted over the raw accent colour. -->
            <SolidColorBrush x:Key="OnAccentBrush">#FFFFFF</SolidColorBrush>

            <SolidColorBrush x:Key="StatusInitialBrush">#98948C</SolidColorBrush>
            <SolidColorBrush x:Key="StatusActiveBrush">#3E74D6</SolidColorBrush>
            <SolidColorBrush x:Key="StatusFinalBrush">#2E7D46</SolidColorBrush>
          </ResourceDictionary>

          <!-- Dark leans cool and deep rather than flat grey: the window is
               near-black with a blue cast, and each level up (column, card,
               chip) is visibly lighter, because shadows carry almost nothing
               against a dark ground — elevation has to come from the surfaces
               themselves. Borders sit lighter than their card for the same
               reason. -->
          <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#2DD4BF</Color>
            <Color x:Key="SystemAccentColorLight1">#48DECB</Color>
            <Color x:Key="SystemAccentColorLight2">#6FE7D7</Color>
            <Color x:Key="SystemAccentColorLight3">#9DF0E4</Color>
            <Color x:Key="SystemAccentColorDark1">#22AA99</Color>
            <Color x:Key="SystemAccentColorDark2">#188173</Color>
            <Color x:Key="SystemAccentColorDark3">#10594F</Color>

            <SolidColorBrush x:Key="AppWindowBrush">#16181D</SolidColorBrush>
            <SolidColorBrush x:Key="AppSurfaceBrush">#1E2128</SolidColorBrush>
            <SolidColorBrush x:Key="AppCardBrush">#262A33</SolidColorBrush>
            <SolidColorBrush x:Key="AppChipBrush">#343A47</SolidColorBrush>
            <SolidColorBrush x:Key="AppBorderBrush">#3A4150</SolidColorBrush>

            <SolidColorBrush x:Key="OverdueBrush">#FF7A66</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityHighBackgroundBrush">#403017</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityHighForegroundBrush">#F5BC6B</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityCriticalBackgroundBrush">#47211C</SolidColorBrush>
            <SolidColorBrush x:Key="PriorityCriticalForegroundBrush">#FA9A87</SolidColorBrush>

            <!-- The dark accent is bright, so text on it goes dark. -->
            <SolidColorBrush x:Key="OnAccentBrush">#0C201C</SolidColorBrush>

            <SolidColorBrush x:Key="StatusInitialBrush">#8B93A1</SolidColorBrush>
            <SolidColorBrush x:Key="StatusActiveBrush">#7CA9F5</SolidColorBrush>
            <SolidColorBrush x:Key="StatusFinalBrush">#5FCE8C</SolidColorBrush>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!-- Toolbar glyphs. PathIcon scales the geometry, so these share no
             particular grid. -->
        <StreamGeometry x:Key="IconSearch">M8.5 3a5.5 5.5 0 1 0 3.25 9.94l3.16 3.16a.75.75 0 1 0 1.06-1.06l-3.16-3.16A5.5 5.5 0 0 0 8.5 3Zm-4 5.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconFilter">M3 5h14v1.5H3V5Zm2.5 4.25h9v1.5h-9v-1.5ZM8 13.5h4V15H8v-1.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M9.25 3.5h1.5v5.75h5.75v1.5h-5.75v5.75h-1.5v-5.75H3.5v-1.5h5.75V3.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M10 4.5A5.5 5.5 0 1 0 15.5 10h1.5A7 7 0 1 1 10 3v-2l4 3-4 3v-2.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M1.91 7.383a8.491 8.491 0 0 1 1.78-3.08.5.5 0 0 1 .54-.135l1.918.686a1 1 0 0 0 1.32-.762l.366-2.006a.5.5 0 0 1 .388-.4 8.532 8.532 0 0 1 3.555 0 .5.5 0 0 1 .389.4l.365 2.006a1 1 0 0 0 1.32.762l1.919-.686a.5.5 0 0 1 .54.136 8.491 8.491 0 0 1 1.78 3.079.5.5 0 0 1-.153.535l-1.555 1.32a1 1 0 0 0 0 1.524l1.555 1.32a.5.5 0 0 1 .152.535 8.491 8.491 0 0 1-1.78 3.08.5.5 0 0 1-.54.135l-1.918-.686a1 1 0 0 0-1.32.762l-.366 2.007a.5.5 0 0 1-.388.399 8.53 8.53 0 0 1-3.555 0 .5.5 0 0 1-.389-.4l-.365-2.006a1 1 0 0 0-1.32-.762l-1.919.686a.5.5 0 0 1-.54-.136 8.49 8.49 0 0 1-1.78-3.079.5.5 0 0 1 .153-.535l1.555-1.32a1 1 0 0 0 0-1.524l-1.555-1.32a.5.5 0 0 1-.152-.535ZM8 10a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M4 5.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10v1.5H7v-1.5ZM4 9.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10V11H7v-1.5ZM4 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10v1.5H7v-1.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconBoard">M3.5 3h3.75v13.5H3.5V3Zm4.75 0H12v9.5H8.25V3ZM13 3h3.5v6H13V3Z</StreamGeometry>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- The typography scale. Three roles below the body text: a section
             header, a field label, and de-emphasised metadata. -->
        <Style Selector="TextBlock.section">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style Selector="TextBlock.group">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style Selector="TextBlock.label">
          <Setter Property="Opacity" Value="0.6" />
          <Setter Property="FontSize" Value="11" />
          <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
          <Setter Property="Opacity" Value="0.6" />
          <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- A due date is quiet until it is overdue, then it is the loudest
             thing on the row. -->
        <Style Selector="TextBlock.due">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.due.overdue">
          <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Chips. Neutral by default; a priority worth noticing tints its
             chip, so High and Low stop looking identical. -->
        <Style Selector="Border.chip">
          <Setter Property="Background" Value="{DynamicResource AppChipBrush}" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="8,2" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip.high">
          <Setter Property="Background" Value="{DynamicResource PriorityHighBackgroundBrush}" />
        </Style>
        <Style Selector="Border.chip.high > TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource PriorityHighForegroundBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.chip.critical">
          <Setter Property="Background" Value="{DynamicResource PriorityCriticalBackgroundBrush}" />
        </Style>
        <Style Selector="Border.chip.critical > TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource PriorityCriticalForegroundBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.chip.low > TextBlock">
          <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- The dot that says what kind of status this is without reading it:
             grey not started, blue under way, green concluded. -->
        <Style Selector="Ellipse.statusdot">
          <Setter Property="Width" Value="8" />
          <Setter Property="Height" Value="8" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.statusdot.initial">
          <Setter Property="Fill" Value="{DynamicResource StatusInitialBrush}" />
        </Style>
        <Style Selector="Ellipse.statusdot.active">
          <Setter Property="Fill" Value="{DynamicResource StatusActiveBrush}" />
        </Style>
        <Style Selector="Ellipse.statusdot.final">
          <Setter Property="Fill" Value="{DynamicResource StatusFinalBrush}" />
        </Style>

        <Style Selector="Border.banner">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Padding" Value="12,10" />
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Application.Styles>
</Application>
