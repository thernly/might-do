<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MightDo.App.App"
             Name="Might Do"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Defining the application menu replaces Avalonia's "About Avalonia"
         fallback on macOS. The platform adds its standard Hide and Quit items
         after this one. -->
    <NativeMenu.Menu>
      <NativeMenu>
        <NativeMenuItem Header="About Might Do…" Click="OnAbout" />
      </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
      <ResourceDictionary>
        <!-- Toolbar glyphs. PathIcon scales the geometry, so these share no
             particular grid. -->
        <StreamGeometry x:Key="IconSearch">M8.5 3a5.5 5.5 0 1 0 3.25 9.94l3.16 3.16a.75.75 0 1 0 1.06-1.06l-3.16-3.16A5.5 5.5 0 0 0 8.5 3Zm-4 5.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconFilter">M3 5h14v1.5H3V5Zm2.5 4.25h9v1.5h-9v-1.5ZM8 13.5h4V15H8v-1.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M9.25 3.5h1.5v5.75h5.75v1.5h-5.75v5.75h-1.5v-5.75H3.5v-1.5h5.75V3.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M10 4.5A5.5 5.5 0 1 0 15.5 10h1.5A7 7 0 1 1 10 3v-2l4 3-4 3v-2.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M1.91 7.383a8.491 8.491 0 0 1 1.78-3.08.5.5 0 0 1 .54-.135l1.918.686a1 1 0 0 0 1.32-.762l.366-2.006a.5.5 0 0 1 .388-.4 8.532 8.532 0 0 1 3.555 0 .5.5 0 0 1 .389.4l.365 2.006a1 1 0 0 0 1.32.762l1.919-.686a.5.5 0 0 1 .54.136 8.491 8.491 0 0 1 1.78 3.079.5.5 0 0 1-.153.535l-1.555 1.32a1 1 0 0 0 0 1.524l1.555 1.32a.5.5 0 0 1 .152.535 8.491 8.491 0 0 1-1.78 3.08.5.5 0 0 1-.54.135l-1.918-.686a1 1 0 0 0-1.32.762l-.366 2.007a.5.5 0 0 1-.388.399 8.53 8.53 0 0 1-3.555 0 .5.5 0 0 1-.389-.4l-.365-2.006a1 1 0 0 0-1.32-.762l-1.919.686a.5.5 0 0 1-.54-.136 8.49 8.49 0 0 1-1.78-3.079.5.5 0 0 1 .153-.535l1.555-1.32a1 1 0 0 0 0-1.524l-1.555-1.32a.5.5 0 0 1-.152-.535ZM8 10a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M4 5.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10v1.5H7v-1.5ZM4 9.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10V11H7v-1.5ZM4 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3 .25h10v1.5H7v-1.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M8 3.5h4l.5 1H16V6H4V4.5h3.5l.5-1ZM5 7h10l-.6 9.1a1.5 1.5 0 0 1-1.5 1.4H7.1a1.5 1.5 0 0 1-1.5-1.4L5 7Zm3.25 2v6h1.5V9h-1.5Zm2.5 0v6h1.5V9h-1.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconWorkspace">M3 5.5A1.5 1.5 0 0 1 4.5 4h3l1.5 1.75h6.5A1.5 1.5 0 0 1 17 7.25v7.25A1.5 1.5 0 0 1 15.5 16h-11A1.5 1.5 0 0 1 3 14.5v-9Z</StreamGeometry>
        <StreamGeometry x:Key="IconTick">M16.03 5.97a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.97 2.97 6.72-6.72a.75.75 0 0 1 1.06 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconBoard">M3.5 3h3.75v13.5H3.5V3Zm4.75 0H12v9.5H8.25V3ZM13 3h3.5v6H13V3Z</StreamGeometry>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- The whole look of the application, and nothing else, lives in
             this one entry. Themes/ holds one file per theme; each is a
             complete look — palette, geometry, type, Fluent's own control
             colours — and Theme.ApplyDesign swaps this element for another
             at run time.

             It is a single slot on purpose. A theme that could only replace
             half of what the previous one set would leave the application
             wearing two designs at once, and the half left behind would be
             whichever half nobody remembered to override.

             Cyrk 66 is the default; the value here is only the look a fresh
             installation starts in, since startup applies the saved choice
             before the window is shown. -->
        <StyleInclude Source="avares://MightDo.App/Themes/Cyrk66.axaml" />
    </Application.Styles>
</Application>
