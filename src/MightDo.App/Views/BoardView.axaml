<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MightDo.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="MightDo.App.Views.BoardView"
             x:DataType="vm:WorkspaceViewModel">

  <UserControl.Styles>
    <!-- Cards sit on the column surface, so they carry the card brush and a
         faint shadow that deepens under the pointer. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #1A000000" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #26000000" />
    </Style>
    <!-- The card the detail pane is showing. -->
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.column">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Width" Value="260" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Columns}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BoardColumnViewModel">
          <!-- The column itself accepts drops, which append to the bottom. -->
          <Border Classes="column" Name="ColumnRoot" Tag="{Binding StatusId}">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="statusdot"
                           Classes.initial="{Binding IsInitialStatus}"
                           Classes.active="{Binding IsActiveStatus}"
                           Classes.final="{Binding IsFinalStatus}" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="hint"
                           VerticalAlignment="Center" />
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MinHeight="120">
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BoardCardViewModel">
                        <!-- Each card is both draggable and a drop target;
                             dropping on a card inserts above it. -->
                        <Border Classes="card" Name="CardRoot" Tag="{Binding Id}"
                                Classes.selected="{Binding IsSelected}">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <Border Classes="chip"
                                      Classes.low="{Binding IsLowPriority}"
                                      Classes.high="{Binding IsHighPriority}"
                                      Classes.critical="{Binding IsCriticalPriority}">
                                <TextBlock Text="{Binding PriorityLabel}" FontSize="11" />
                              </Border>
                              <Border Classes="chip" IsVisible="{Binding HasCategory}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                           Fill="{Binding CategoryBrush}" />
                                  <TextBlock Text="{Binding CategoryName}" FontSize="11" />
                                </StackPanel>
                              </Border>
                              <Border Classes="chip" IsVisible="{Binding HasSteps}">
                                <TextBlock Text="{Binding StepsLabel}" FontSize="11" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DueLabel}" Classes="due"
                                       Classes.overdue="{Binding IsOverdue}"
                                       IsVisible="{Binding HasDue}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Classes="hint" Text="Drop here" Margin="4,6"
                             IsVisible="{Binding IsEmpty}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
