<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MightDo.App.ViewModels"
        xmlns:views="clr-namespace:MightDo.App.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="MightDo.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="might-do"
        Width="1000" Height="700"
        MinWidth="640" MinHeight="420"
        Background="{DynamicResource AppWindowBrush}">

  <Panel>
    <!-- No workspace yet: ask for one. -->
    <Border IsVisible="{Binding !HasWorkspace}" Padding="48">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="12" MaxWidth="520">
        <TextBlock Text="might-do" FontSize="30" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Text="Choose a folder for your tasks. Everything is kept as plain JSON files beneath it, one per task — put it inside OneDrive, Dropbox or iCloud Drive and your tasks follow you between machines." />
        <Button Content="Choose a folder…"
                Command="{Binding ChooseWorkspaceCommand}"
                HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Message}" Classes="hint"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- A workspace is open. The visibility test belongs to the shell, so it
         sits outside the element that rebinds to the workspace. -->
    <Border IsVisible="{Binding HasWorkspace}">
    <Grid DataContext="{Binding Workspace}"
          x:DataType="vm:WorkspaceViewModel"
          RowDefinitions="Auto,Auto,*,Auto" Margin="16">

      <!-- Toolbar. The filter controls live behind a button; the search box
           does not, which is why the count on that button ignores it. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
        <TextBox Grid.Column="0" PlaceholderText="Search summaries, notes and steps"
                 Text="{Binding Search}" MinWidth="200">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                      Margin="10,0,2,0" Opacity="0.5" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <ToggleButton Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding FiltersOpen}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconFilter}" Width="13" Height="13"
                      VerticalAlignment="Center" />
            <TextBlock Text="Filters" VerticalAlignment="Center" />
            <Border CornerRadius="9" Padding="6,1" IsVisible="{Binding HasPanelFilters}"
                    Background="{DynamicResource SystemAccentColor}">
              <TextBlock Text="{Binding PanelFilterCount}" FontSize="11"
                         Foreground="{DynamicResource OnAccentBrush}" />
            </Border>
          </StackPanel>
        </ToggleButton>

        <!-- Disabled rather than hidden on the board, whose order is the user's
             own drag-and-drop one and cannot also be a computed sort. Hiding it
             would reshuffle the toolbar on every view switch. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                    IsEnabled="{Binding IsListView}">
          <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6" />
          <ComboBox MinWidth="150"
                    ItemsSource="{Binding SortOptions}"
                    DisplayMemberBinding="{Binding Label}"
                    SelectedValueBinding="{Binding Value}"
                    SelectedValue="{Binding Sort}"
                    ToolTip.Tip="How the list is ordered. The board keeps the order you drag cards into." />
        </StackPanel>

        <Button Grid.Column="3" Margin="8,0,0,0" Content="Clear"
                Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding IsFiltered}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
          <RadioButton GroupName="ViewMode" IsChecked="{Binding IsListView}"
                       Command="{Binding ShowListCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconList}" Width="13" Height="13"
                        VerticalAlignment="Center" />
              <TextBlock Text="List" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="ViewMode" IsChecked="{Binding IsBoardView}"
                       Command="{Binding ShowBoardCommand}" VerticalAlignment="Center"
                       Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconBoard}" Width="13" Height="13"
                        VerticalAlignment="Center" />
              <TextBlock Text="Board" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Grid>

      <!-- Banners: reminders, sync conflicts, missing folder -->
      <StackPanel Grid.Row="1">
        <Border Classes="banner" IsVisible="{Binding FiltersOpen}">
          <StackPanel Spacing="10">
            <WrapPanel>
              <StackPanel Margin="0,0,20,6" MinWidth="140">
                <TextBlock Text="Status" Classes="group" />
                <ItemsControl ItemsSource="{Binding Statuses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterToggle">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,0,20,6" MinWidth="120">
                <TextBlock Text="Status Type" Classes="group" />
                <ItemsControl ItemsSource="{Binding StatusTypes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterToggle">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,0,20,6" MinWidth="120">
                <TextBlock Text="Priority" Classes="group" />
                <ItemsControl ItemsSource="{Binding Priorities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterToggle">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,0,20,6" MinWidth="140">
                <TextBlock Text="Category" Classes="group" />
                <ItemsControl ItemsSource="{Binding Categories}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterToggle">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No categories yet" Classes="hint"
                           IsVisible="{Binding !Categories.Count}" />
              </StackPanel>

              <StackPanel Margin="0,0,20,6" MinWidth="140">
                <TextBlock Text="Tags" Classes="group" />
                <ItemsControl ItemsSource="{Binding TagFilters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterToggle">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No tags yet" Classes="hint"
                           IsVisible="{Binding !TagFilters.Count}" />
              </StackPanel>

              <StackPanel Margin="0,0,20,6" MinWidth="120">
                <TextBlock Text="Show" Classes="group" />
                <CheckBox Content="Overdue only" IsChecked="{Binding OverdueOnly}" />
                <CheckBox Content="Completed" IsChecked="{Binding IncludeCompleted}" />
              </StackPanel>
            </WrapPanel>

            <TextBlock Classes="hint"
                       Text="Selecting a Final status, or the Final Status Type, shows completed work without ticking Completed." />
          </StackPanel>
        </Border>

        <Border Classes="banner"
                IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="banner" IsVisible="{Binding OutstandingReminders.Count}">
          <StackPanel Spacing="4">
            <TextBlock Text="Reminders" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding OutstandingReminders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DueReminderViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Summary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding When}" Classes="hint"
                               Margin="8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Dismiss"
                            Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).DismissReminderCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="banner" IsVisible="{Binding Conflicts.Count}">
          <StackPanel Spacing="4">
            <TextBlock Text="Sync conflicts" FontWeight="SemiBold" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Your sync client left copies of these files in the tasks folder. They are not loaded — open the folder to resolve them." />
            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- The list, and the detail pane for whatever is selected -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
      <Border Grid.Column="0" BorderThickness="1" CornerRadius="8"
              IsVisible="{Binding IsListView}"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}">
        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{Binding Summary}" FontSize="14"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Classes="statusdot"
                                 Classes.initial="{Binding IsInitialStatus}"
                                 Classes.active="{Binding IsActiveStatus}"
                                 Classes.final="{Binding IsFinalStatus}" />
                        <TextBlock Text="{Binding StatusName}" FontSize="12" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chip"
                            Classes.low="{Binding IsLowPriority}"
                            Classes.high="{Binding IsHighPriority}"
                            Classes.critical="{Binding IsCriticalPriority}">
                      <TextBlock Text="{Binding PriorityLabel}" FontSize="12" />
                    </Border>
                    <Border Classes="chip" IsVisible="{Binding HasCategory}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding CategoryBrush}" />
                        <TextBlock Text="{Binding CategoryName}" FontSize="12" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chip" IsVisible="{Binding HasSteps}">
                      <TextBlock Text="{Binding StepsLabel}" FontSize="12" />
                    </Border>
                    <TextBlock Classes="hint" VerticalAlignment="Center"
                               IsVisible="{Binding HasTags}" Text="{Binding TagNames}" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DueLabel}"
                           IsVisible="{Binding HasDue}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Classes="due"
                           Classes.overdue="{Binding IsOverdue}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <views:BoardView Grid.Column="0" IsVisible="{Binding IsBoardView}" />

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                    IsVisible="{Binding HasSelection}" />

      <Border Grid.Column="2" Width="400" BorderThickness="1" CornerRadius="8"
              IsVisible="{Binding HasSelection}"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BoxShadow="0 1 4 0 #22000000">
        <Grid RowDefinitions="Auto,Auto,*">
          <Button Grid.Row="0" Content="Close" HorizontalAlignment="Right" Margin="8,8,8,0"
                  Command="{Binding CloseDetailCommand}" />

          <!-- Why the list behind this pane has nothing selected. -->
          <TextBlock Grid.Row="1" Margin="16,8,16,0" TextWrapping="Wrap"
                     Classes="hint"
                     IsVisible="{Binding SelectionHiddenFromList}"
                     Text="Not in the list — the current filter hides it." />

          <views:TaskDetailView Grid.Row="2" DataContext="{Binding Detail}" />
        </Grid>
      </Border>
      </Grid>

      <!-- Create, and the status line -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
        <TextBox Grid.Column="0" PlaceholderText="Add a task and press Enter"
                 Text="{Binding NewTaskSummary}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CreateTaskCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Margin="8,0,0,0" Classes="accent"
                Command="{Binding CreateTaskCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12"
                      VerticalAlignment="Center" />
            <TextBlock Text="Add" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13"
                      VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Margin="8,0,0,0" Click="OnOpenSettings">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconSettings}" Width="13" Height="13"
                      VerticalAlignment="Center" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="4" Margin="12,0,0,0" Classes="hint"
                   VerticalAlignment="Center" Text="{Binding SummaryLine}" />
      </Grid>
    </Grid>
    </Border>
  </Panel>
</Window>
