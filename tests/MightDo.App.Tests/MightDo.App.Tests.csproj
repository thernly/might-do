<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    xunit.v3 here and xunit 2 in the other two test projects, which is not a
    preference: Avalonia.Headless.XUnit 12 depends on xunit.v3.extensibility.core,
    and [AvaloniaFact] is what runs a test on a dispatcher. The other two need
    no dispatcher and are not worth the churn of moving.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MightDo.App\MightDo.App.csproj" />
  </ItemGroup>

</Project>